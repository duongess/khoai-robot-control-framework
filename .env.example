NEUPRINT_TOKEN=your_token_here

# Dual-loop fly-connectome + SAC residual (all action coefficients normalized).
LEARNER_RESIDUAL_ALPHA_X=0.20
LEARNER_RESIDUAL_ALPHA_Y=0.15
# 0.30 ~= 3.6 N/s with force-control's default 12 N/s grip actuator.
LEARNER_RESIDUAL_ALPHA_GRIP=0.30
LEARNER_BASE_WARMUP_STEPS=128
LEARNER_BASE_LR_MULTIPLIER=0.10
LEARNER_SLIP_SEVERITY_OBSERVATION_INDEX=17
LEARNER_GRIP_FORCE_OBSERVATION_INDEX=16
LEARNER_VERTICAL_ACCELERATION_OBSERVATION_INDEX=18
LEARNER_PREVIOUS_VERTICAL_ACTION_OBSERVATION_INDEX=26
